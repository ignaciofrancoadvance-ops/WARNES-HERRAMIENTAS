# --- Integraciones (copiá este archivo como .env.local y completá los valores) ---

# Número de WhatsApp en formato internacional SIN "+", espacios ni guiones.
# Argentina: 549 + característica sin 0 + número sin 15. Ej: 5491133334444
NEXT_PUBLIC_WHATSAPP_NUMBER=5491100000000

# Mensaje precargado al abrir WhatsApp (opcional)
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hola Advance Group, quiero coordinar una llamada sobre importación.

# URL pública de tu Calendly (el evento que querés ofrecer).
# Ej: https://calendly.com/advancegroup/llamada-importacion
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/advancegroup/30min

# Datos de contacto que se muestran en el footer (opcionales)
NEXT_PUBLIC_CONTACT_EMAIL=comex@advancegrouparg.com
NEXT_PUBLIC_CONTACT_PHONE=+54 9 11 0000-0000
